{
  "name": "heart-risk-mlops",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "latest", "helm": "none" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "forwardPorts": [5000, 8000, 8080, 9090, 3000],
  "portsAttributes": {
    "5000": { "label": "MLflow UI" },
    "8000": { "label": "API (local/docker)" },
    "8080": { "label": "API (minikube)" },
    "9090": { "label": "Prometheus" },
    "3000": { "label": "Grafana" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-toolsai.jupyter", "ms-kubernetes-tools.vscode-kubernetes-tools"] }
  }
}
